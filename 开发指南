## 9. docker‑compose.yml（摘录）

```yaml
version: "3.9"
services:
  nginx:
    image: nginx:1.25-alpine
    ports: ["443:443"]
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf
      - ./frontend/dist:/usr/share/nginx/html:ro
    depends_on: [backend, chat, guacd, tomcat]

  backend:
    build: ./backend
    environment:
      - DB_PATH=/data/app.db
    volumes:
      - ./data:/data

  chat:
    build: ./chat
    volumes:
      - ./data:/data

  redis:
    image: redis:7-alpine

  guacd:
    image: guacamole/guacd:1.5.5

  tomcat:
    image: guacamole/guacamole:1.5.5
    environment:
      GUACD_HOSTNAME: guacd
      MYSQL_DISABLED: "true"

  manager:
    build: ./manager
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/lxcfs/proc:/proc:ro
    depends_on: [redis]
```

> **说明**：桌面容器 `desk‑<cid>` 由 `manager` 动态 `docker run`，不写入 compose。

